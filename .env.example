DATABASE_URL=postgresql://doza:password@localhost:5432/doza
NEXTAUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Адрес сайта – из него собираются ссылки в SMS (согласие на обработку ПД).
# Если не задан, используется https://doza-parfum.by
SITE_URL=https://doza-parfum.by

# Telegram-уведомления о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Копия уведомлений личным аккаунтам (через запятую), помимо канала
TELEGRAM_EXTRA_CHAT_IDS=

# SMS (sms-assistent.by)
SMS_LOGIN=
SMS_PASSWORD=
SMS_SENDER=doza-parfum

# Секрет для cron-задач (напоминания об акциях)
CRON_SECRET=change_me_random_string

# bePaid (интернет-эквайринг). BEPAID_TEST=1 – проводить тестовые транзакции.
BEPAID_SHOP_ID=
BEPAID_SECRET_KEY=
BEPAID_TEST=0

# Meta (Facebook) Pixel и Conversions API.
# META_PIXEL_ID – номер пикселя из Events Manager. Пусто – пиксель не ставится
# и покупки в Meta не уходят: при разработке статистику засорять незачем.
# META_CAPI_TOKEN – токен доступа оттуда же (Настройки пикселя → Conversions API).
# META_TEST_EVENT_CODE – код тестового события: видно в Events Manager,
# в статистику и обучение не попадает. На боевом сервере оставить пустым.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Техническая апишка CRM (каталог, остатки, акции, настройки).
# Генерировать: openssl rand -hex 32. Пусто – апишка отключена.
# Клиентов, заказов и денег в ней нет намеренно: токеном пользуются снаружи,
# и считать его тайной нельзя.
ADMIN_API_TOKEN=
