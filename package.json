{
  "name": "doza",
  "private": true,
  "//packageManager": "Версия pnpm закреплена намеренно: без этого поля corepack в образе тянет свежайшую мажорную, и сборка ломается на ровном месте от чужого релиза.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev:site": "pnpm --filter @doza/site dev",
    "dev:crm": "pnpm --filter @doza/crm dev",
    "db:migrate": "pnpm --filter @doza/db prisma migrate dev",
    "db:generate": "pnpm --filter @doza/db prisma generate",
    "db:studio": "pnpm --filter @doza/db prisma studio",
    "build": "pnpm --filter @doza/db prisma generate && pnpm -r build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
