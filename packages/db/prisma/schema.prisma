generator client {
  provider      = "prisma-client-js"
  // native — для локальной разработки (Windows); musl-openssl-3.0.x — для Alpine в Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Справочники ───────────────────────────────────────────────────────────────

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Setting {
  key   String @id
  value String
}

// ─── Пользователи CRM ──────────────────────────────────────────────────────────

model CrmUser {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String
  role         CrmRole
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  offlineSales OfflineSale[]
  offlineSalesCreated OfflineSale[] @relation("OfflineSaleCreatedBy")
  inventoryLog InventoryLog[]
  preorders    Preorder[]
  certificatesIssued    GiftCertificate[] @relation("CertificateIssuedBy")
  certificatesActivated GiftCertificate[] @relation("CertificateActivatedBy")
  certificateRedemptions CertificateRedemption[]
  salesSplitsAsSource   SalesSplit[]      @relation("SalesSplitSource")
  salesSplitsCreated    SalesSplit[]      @relation("SalesSplitCreatedBy")
  salesSplitShares      SalesSplitShare[]

  @@map("crm_users")
}

// Предзаказ целого флакона (нет в каталоге). Продавец фиксирует пожелание, дальше вручную.
model Preorder {
  id           Int       @id @default(autoincrement())
  customerName String    @map("customer_name")
  phone        String
  wish         String
  note         String?
  status       String    @default("new") // new | done | cancelled
  sellerId     Int       @map("seller_id")
  seller       CrmUser   @relation(fields: [sellerId], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at")
  closedAt     DateTime? @map("closed_at")

  @@map("preorders")
}

enum CrmRole {
  admin
  seller
  marketer
}

// ─── Товары ────────────────────────────────────────────────────────────────────

model Product {
  id                     Int              @id @default(autoincrement())
  brandId                Int              @map("brand_id")
  brand                  Brand            @relation(fields: [brandId], references: [id])
  name                   String
  slug                   String           @unique
  gender                 Gender
  notesTop               String?          @map("notes_top")
  notesMid               String?          @map("notes_mid")
  notesBase              String?          @map("notes_base")
  description            String?
  isArchived             Boolean          @default(false) @map("is_archived")
  loyaltyPercentOverride Decimal?         @map("loyalty_percent_override") @db.Decimal(5, 2)
  lowStockThreshold      Int?             @map("low_stock_threshold")
  photos                 ProductPhoto[]
  volumes                ProductVolume[]
  similarTo              ProductSimilar[] @relation("ProductSimilarFrom")
  similarFrom            ProductSimilar[] @relation("ProductSimilarTo")
  inventory              Inventory?
  inventoryLog           InventoryLog[]
  orderItems             OrderItem[]
  offlineSaleItems       OfflineSaleItem[]
  promos                 Promo[]
  superPromos            SuperPromoProduct[]

  @@map("products")
}

// ─── Акции (скидки / повышенный кешбек по времени) ──────────────────────────────

model Promo {
  /// productId = null → акция на ВСЕ товары каталога.
  id              Int       @id @default(autoincrement())
  productId       Int?      @map("product_id")
  product         Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  cashbackPercent Decimal?  @map("cashback_percent") @db.Decimal(5, 2)
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  reminderSent    Boolean   @default(false) @map("reminder_sent")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([productId])
  @@map("promos")
}

/// Тип шаблона супер-акции. Пока один: каждый N-й товар в чеке бесплатно.
enum SuperPromoKind {
  n_plus_one
}

/// «Супер акции» — сложные механики на весь чек (в отличие от Promo, которая
/// даёт процент на конкретный товар).
model SuperPromo {
  id        Int                 @id @default(autoincrement())
  name      String
  kind      SuperPromoKind      @default(n_plus_one)
  /// Размер группы: каждый `groupSize`-й товар бесплатно (3 → «1+1=3»).
  groupSize Int                 @default(3) @map("group_size")
  /// true → участвуют все товары каталога, список `products` игнорируется.
  allProducts Boolean           @default(false) @map("all_products")
  isActive  Boolean             @default(true) @map("is_active")
  startsAt  DateTime?           @map("starts_at")
  endsAt    DateTime?           @map("ends_at")
  createdAt DateTime            @default(now()) @map("created_at")
  products  SuperPromoProduct[]

  @@map("super_promos")
}

model SuperPromoProduct {
  superPromoId Int        @map("super_promo_id")
  superPromo   SuperPromo @relation(fields: [superPromoId], references: [id], onDelete: Cascade)
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([superPromoId, productId])
  @@index([productId])
  @@map("super_promo_products")
}

enum Gender {
  male
  female
  unisex
}

model ProductPhoto {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  url       String
  sortOrder Int     @default(0) @map("sort_order")

  @@map("product_photos")
}

model ProductVolume {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  volumeMl  Int     @map("volume_ml")
  priceByn  Decimal @map("price_byn") @db.Decimal(10, 2)
  isActive  Boolean @default(true) @map("is_active")

  @@unique([productId, volumeMl])
  @@map("product_volumes")
}

model ProductSimilar {
  productId   Int     @map("product_id")
  product     Product @relation("ProductSimilarFrom", fields: [productId], references: [id])
  similarId   Int     @map("similar_id")
  similar     Product @relation("ProductSimilarTo", fields: [similarId], references: [id])

  @@id([productId, similarId])
  @@map("product_similar")
}

// ─── Склад ────────────────────────────────────────────────────────────────────

model Inventory {
  productId  Int     @id @map("product_id")
  product    Product @relation(fields: [productId], references: [id])
  quantityMl Int     @default(0) @map("quantity_ml")

  @@map("inventory")
}

model InventoryLog {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  deltaMl   Int      @map("delta_ml")
  reason    String
  refType   String?  @map("ref_type")
  refId     Int?     @map("ref_id")
  userId    Int?     @map("user_id")
  user      CrmUser? @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_log")
}

// ─── Клиенты ──────────────────────────────────────────────────────────────────

model Customer {
  id              Int              @id @default(autoincrement())
  phone           String           @unique
  name            String
  passwordHash    String?          @map("password_hash")
  phoneVerified   Boolean          @default(false) @map("phone_verified")
  vipCardNumber   String?          @unique @map("vip_card_number")
  birthday        DateTime?        @db.Date
  registeredAt    DateTime         @default(now()) @map("registered_at")
  lastPurchaseAt  DateTime?        @map("last_purchase_at")
  lastPurchaseSum Decimal?         @map("last_purchase_sum") @db.Decimal(10, 2)

  /// Согласие на обработку персональных данных для программы лояльности
  /// (закон РБ №99-З). Сама покупка согласия не требует — данные для заказа
  /// обрабатываются по основанию «исполнение договора». Согласие нужно только
  /// для хранения клиента в базе лояльности: баллы, VIP, персональные рассылки.
  consentStatus      ConsentStatus @default(pending) @map("consent_status")
  /// Когда последний раз отправляли ссылку на подтверждение.
  consentRequestedAt DateTime?     @map("consent_requested_at")
  consentConfirmedAt DateTime?     @map("consent_confirmed_at")

  dates           CustomerDate[]
  dateRewards     DateReward[]
  orders          Order[]
  offlineSales    OfflineSale[]
  loyaltyBatches  LoyaltyBatch[]
  loyaltyLog      LoyaltyLog[]
  certificatesBought    GiftCertificate[] @relation("CertificateBuyer")
  certificatesActivated GiftCertificate[] @relation("CertificateActivatedFor")

  @@map("customers")
}

/// Статус согласия на обработку ПД для программы лояльности.
/// Отзыв согласия отдельным статусом не выделяем: по 99-З отзыв означает
/// прекращение обработки, то есть удаление клиента из базы лояльности.
enum ConsentStatus {
  pending
  confirmed
}

/// Разделение выручки одного дня между продавцами.
///
/// Нужно, когда на смене работали двое под одним аккаунтом: чеки записаны на
/// один `sourceSeller`, а по-честному выручку надо разнести. Влияет только на
/// трекер продаж продавцов — сами чеки, остатки и баллы не трогаются.
model SalesSplit {
  id             Int               @id @default(autoincrement())
  /// День, за который делится выручка.
  date           DateTime          @db.Date
  /// Аккаунт, под которым оформлялись продажи в этот день.
  sourceSellerId Int               @map("source_seller_id")
  sourceSeller   CrmUser           @relation("SalesSplitSource", fields: [sourceSellerId], references: [id])
  createdById    Int               @map("created_by_id")
  createdBy      CrmUser           @relation("SalesSplitCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now()) @map("created_at")
  shares         SalesSplitShare[]

  /// На день+аккаунт может быть только одно разделение.
  @@unique([date, sourceSellerId])
  @@map("sales_splits")
}

model SalesSplitShare {
  id       Int        @id @default(autoincrement())
  splitId  Int        @map("split_id")
  split    SalesSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  sellerId Int        @map("seller_id")
  seller   CrmUser    @relation(fields: [sellerId], references: [id])
  /// Доля продавца в процентах. Сумма долей одного разделения = 100.
  percent  Decimal    @db.Decimal(5, 2)

  @@unique([splitId, sellerId])
  @@map("sales_split_shares")
}

enum GiftCertificateStatus {
  /// Выпущен и оплачен. Остаток можно тратить в кассе или обменять на баллы.
  new
  /// Обменян на баллы — начисление разовое, остаток обнулён.
  activated
  /// Остаток израсходован в кассе.
  spent
  /// Аннулирован вручную (ошибка выпуска и т.п.).
  cancelled
}

/// Подарочный сертификат: выпускается в CRM с уникальным кодом.
///
/// Использовать можно одним из двух способов — потратить остаток в кассе или
/// обменять на баллы. Способы не смешиваются: как только по коду прошло
/// списание в кассе, обменять его на баллы уже нельзя, и наоборот. Иначе одну
/// и ту же сумму можно получить дважды.
///
/// Оплата сертификатом не требует ни номера телефона, ни согласия на обработку
/// данных: это платёжное средство на предъявителя, а не программа лояльности.
model GiftCertificate {
  id            Int                   @id @default(autoincrement())
  /// 8 символов, латиница в верхнем регистре + цифры.
  code          String                @unique
  /// Номинал сертификата.
  denomination  Decimal               @db.Decimal(10, 2)
  /// Сколько реально заплатили при покупке (с учётом VIP-скидки покупателя).
  /// Именно эта сумма начисляется, если активирует VIP-клиент.
  paidByn       Decimal               @map("paid_byn") @db.Decimal(10, 2)
  /// Неизрасходованный остаток. При выпуске равен номиналу, уменьшается при
  /// оплате в кассе. Остаток не сгорает после покупки — покупатель донабирает
  /// его в следующие визиты, пока не кончится срок.
  balanceByn    Decimal               @map("balance_byn") @db.Decimal(10, 2)
  status        GiftCertificateStatus @default(new)

  /// Покупатель (если известен) — нужен для VIP-скидки при покупке.
  buyerId       Int?                  @map("buyer_id")
  buyer         Customer?             @relation("CertificateBuyer", fields: [buyerId], references: [id])
  issuedById    Int                   @map("issued_by_id")
  issuedBy      CrmUser               @relation("CertificateIssuedBy", fields: [issuedById], references: [id])
  issuedAt      DateTime              @default(now()) @map("issued_at")
  /// Срок жизни — 180 дней от выпуска, а не от активации: иначе сертификат,
  /// пролежавший в столе два года, пришлось бы принимать по старой цене.
  expiresAt     DateTime              @map("expires_at")

  redemptions   CertificateRedemption[]

  /// Кому начислены баллы при активации.
  customerId    Int?                  @map("customer_id")
  customer      Customer?             @relation("CertificateActivatedFor", fields: [customerId], references: [id])
  /// Сотрудник, активировавший сертификат. null → клиент активировал сам на сайте.
  activatedById Int?                  @map("activated_by_id")
  activatedBy   CrmUser?              @relation("CertificateActivatedBy", fields: [activatedById], references: [id])
  activatedAt   DateTime?             @map("activated_at")
  /// Сколько баллов фактически начислено (номинал или уплаченная сумма для VIP).
  awardedByn    Decimal?              @map("awarded_byn") @db.Decimal(10, 2)

  @@index([status])
  @@map("gift_certificates")
}

/// Списание с сертификата в кассе.
///
/// Отдельная запись на каждое использование: остаток тратится частями, и без
/// журнала нельзя ни объяснить покупателю, куда делись деньги, ни вернуть их
/// при отмене чека.
model CertificateRedemption {
  id            Int             @id @default(autoincrement())
  certificateId Int             @map("certificate_id")
  certificate   GiftCertificate @relation(fields: [certificateId], references: [id])
  saleId        Int             @map("sale_id")
  sale          OfflineSale     @relation(fields: [saleId], references: [id])
  amountByn     Decimal         @map("amount_byn") @db.Decimal(10, 2)
  /// Остаток после списания — чтобы историю можно было читать, не пересчитывая.
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(10, 2)
  /// Отменено вместе с чеком: сумма возвращена на сертификат.
  revokedAt     DateTime?       @map("revoked_at")
  userId        Int?            @map("user_id")
  user          CrmUser?        @relation(fields: [userId], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([certificateId])
  @@index([saleId])
  @@map("certificate_redemptions")
}

/// Одноразовые SMS-коды (регистрация, сброс пароля, списание баллов и т.д.)
model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  purpose   String // register | reset | loyalty_spend | offline_register
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@map("sms_codes")
}

/// Журнал всех отправленных SMS.
///
/// Нужен не для истории ради истории: без него не видно, что реально уходит
/// клиентам. Повторные напоминания о согласии рассылались людям ежедневно, и
/// заметить это можно было только по жалобе. Теперь по журналу считается
/// пауза между отправками и лимит попыток.
model SmsLog {
  id         Int       @id @default(autoincrement())
  phone      String
  /// Категория: consent_invite | consent_reminder | otp_register | purchase | …
  kind       String
  text       String
  /// Ушло ли сообщение (ответ шлюза).
  ok         Boolean
  error      String?
  customerId Int?      @map("customer_id")
  /// Кто инициировал: сотрудник CRM или null, если отправил сайт/система.
  userId     Int?      @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, kind])
  @@index([createdAt])
  @@map("sms_log")
}

model CustomerDate {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id])
  date        DateTime @db.Date
  description String
  rewards     DateReward[]

  @@map("customer_dates")
}

/// Что дарим по дате: баллы на день рождения или разовую скидку на памятную.
enum DateRewardKind {
  birthday
  memorable
}

/// Награда за дату: подарок ко дню рождения или разовая скидка к памятной дате.
///
/// Отдельная запись нужна по двум причинам. Во-первых, начисление обязано быть
/// однократным: задача крутится каждый час, и без следа «уже выдано» клиент
/// получал бы подарок двадцать четыре раза в сутки. Во-вторых, скидку покупатель
/// вправе не использовать сразу — она ждёт его до конца срока, и это состояние
/// нужно где-то хранить.
model DateReward {
  id             Int            @id @default(autoincrement())
  customerId     Int            @map("customer_id")
  customer       Customer       @relation(fields: [customerId], references: [id])
  kind           DateRewardKind
  /// Памятная дата, породившая скидку. null — день рождения.
  customerDateId Int?           @map("customer_date_id")
  customerDate   CustomerDate?  @relation(fields: [customerDateId], references: [id])

  /// Повод в виде строки: `birthday-2026` или `date-17-2026`. Именно по нему
  /// работает защита от повторной выдачи — составной ключ с nullable-колонкой
  /// в Postgres не сработал бы, там NULL не равен NULL.
  occasionKey    String         @map("occasion_key")

  /// Скидка в процентах (для памятной даты).
  percent        Decimal?       @db.Decimal(5, 2)
  /// Подаренные баллы (для дня рождения).
  pointsByn      Decimal?       @map("points_byn") @db.Decimal(10, 2)

  validFrom      DateTime       @map("valid_from")
  validUntil     DateTime       @map("valid_until")
  /// Когда скидку применили в кассе. null — ещё не использована.
  usedAt         DateTime?      @map("used_at")
  usedSaleId     Int?           @map("used_sale_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([customerId, occasionKey])
  @@index([customerId, usedAt])
  @@map("date_rewards")
}

// ─── Лояльность ───────────────────────────────────────────────────────────────

model LoyaltyBatch {
  id         Int          @id @default(autoincrement())
  customerId Int          @map("customer_id")
  customer   Customer     @relation(fields: [customerId], references: [id])
  amountByn  Decimal      @map("amount_byn") @db.Decimal(10, 2)
  expiresAt  DateTime?    @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  refType    String?      @map("ref_type")
  refId      Int?         @map("ref_id")
  log        LoyaltyLog[]

  @@map("loyalty_batches")
}

model LoyaltyLog {
  id         Int          @id @default(autoincrement())
  customerId Int          @map("customer_id")
  customer   Customer     @relation(fields: [customerId], references: [id])
  batchId    Int?         @map("batch_id")
  batch      LoyaltyBatch? @relation(fields: [batchId], references: [id])
  deltaByn   Decimal      @map("delta_byn") @db.Decimal(10, 2)
  opType     LoyaltyOp    @map("op_type")
  refType    String?      @map("ref_type")
  refId      Int?         @map("ref_id")
  /// Причина начисления вручную (обязательна при ручном начислении админом).
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@map("loyalty_log")
}

enum LoyaltyOp {
  earned
  spent
  expired
}

// ─── Онлайн-заказы ────────────────────────────────────────────────────────────

model Order {
  id              Int         @id @default(autoincrement())
  customerId      Int?        @map("customer_id")
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String      @map("customer_name")
  customerPhone   String      @map("customer_phone")
  status          OrderStatus @default(new)
  deliveryType    DeliveryType @map("delivery_type")

  /// Данные посылки. Заполняются только при доставке почтой — при самовывозе
  /// пусты. ФИО получателя хранится отдельно от имени клиента: посылка может
  /// идти другому человеку (подарок, родственник), и перезаписывать этим имя
  /// постоянного покупателя нельзя.
  deliveryService DeliveryService? @map("delivery_service")
  recipientLastName   String? @map("recipient_last_name")
  recipientFirstName  String? @map("recipient_first_name")
  recipientMiddleName String? @map("recipient_middle_name")
  postalCode      String?      @map("postal_code")
  region          String?
  city            String?
  address         String?
  comment         String?
  totalByn        Decimal     @map("total_byn") @db.Decimal(10, 2)
  loyaltySpentByn Decimal     @default(0) @map("loyalty_spent_byn") @db.Decimal(10, 2)
  trackingNumber  String?     @map("tracking_number")

  /// Оплата заказа. Магазин работает по стопроцентной предоплате, поэтому
  /// заказ нельзя собирать и отправлять, пока здесь не `paid`.
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  paidAt          DateTime?     @map("paid_at")
  payments        Payment[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]

  @@map("orders")
}

enum PaymentStatus {
  /// Заказ создан, оплату ждём.
  pending
  /// Деньги получены и подтверждены запросом к платёжному шлюзу.
  paid
  /// Шлюз отклонил оплату.
  failed
  /// Покупатель не оплатил в отведённое время.
  expired
  /// Деньги возвращены покупателю.
  refunded
}

/// Способ оплаты. ЕРИП заведён заранее, но пока не подключён.
enum PaymentMethodKind {
  card
  erip
}

/// Попытка оплаты через bePaid.
///
/// Одна на каждый переход к оплате: покупатель может вернуться и попробовать
/// снова, и каждая попытка должна остаться в истории — иначе при разборе
/// спорного платежа неоткуда узнать, что происходило.
model Payment {
  id         Int               @id @default(autoincrement())
  orderId    Int               @map("order_id")
  order      Order             @relation(fields: [orderId], references: [id])
  method     PaymentMethodKind @default(card)

  /// Токен платежа bePaid. По нему запрашивается настоящий статус — телу
  /// уведомления доверять нельзя, оно ничем не подписано.
  token      String            @unique
  /// UID транзакции в шлюзе, появляется после обработки.
  uid        String?
  amountByn  Decimal           @map("amount_byn") @db.Decimal(10, 2)
  status     String            @default("pending")
  /// Тестовая транзакция. В проде такие не засчитываются как оплата.
  isTest     Boolean           @default(false) @map("is_test")
  /// Сообщение шлюза — пригодится, когда покупатель спросит, почему отказ.
  message    String?
  paidAt     DateTime?         @map("paid_at")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

/// Путь заказа: new → confirmed → decanted → packed → shipped.
/// Возврат (`refunded`) возможен с любого шага — это решение админа, а не
/// очередная ступень.
///
/// `closed`, `rejected` и `returned` остались от прежней схемы с оплатой при
/// получении. Новым заказам они не назначаются, но значения нужны, чтобы не
/// потерять historical-данные уже закрытых заказов.
enum OrderStatus {
  new
  confirmed
  /// Отлит из флакона — здесь списываются остатки.
  decanted
  packed
  shipped
  refunded

  closed
  rejected
  returned
}

/// Служба доставки. Нужна для трек-номера и текста SMS покупателю.
enum DeliveryService {
  europochta
  belpochta
}

enum DeliveryType {
  pickup
  post
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  volumeMl  Int     @map("volume_ml")
  qty       Int
  priceByn  Decimal @map("price_byn") @db.Decimal(10, 2)

  @@map("order_items")
}

// ─── Оффлайн-продажи ──────────────────────────────────────────────────────────

model OfflineSale {
  id              Int               @id @default(autoincrement())
  customerId      Int?              @map("customer_id")
  customer        Customer?         @relation(fields: [customerId], references: [id])
  /// Продавец, которому засчитывается продажа (в журнале и отчётах).
  sellerId        Int               @map("seller_id")
  seller          CrmUser           @relation(fields: [sellerId], references: [id])
  /// Кто фактически пробил чек, если это не `seller` (админ оформил от лица
  /// сотрудника). null → пробил сам `seller`.
  createdById     Int?              @map("created_by_id")
  createdBy       CrmUser?          @relation("OfflineSaleCreatedBy", fields: [createdById], references: [id])
  status          OfflineSaleStatus @default(open)
  totalByn        Decimal           @default(0) @map("total_byn") @db.Decimal(10, 2)
  discountByn     Decimal           @default(0) @map("discount_byn") @db.Decimal(10, 2)
  /// Какая механика скидки победила: vip | social | super | promo | null.
  discountKind    String?           @map("discount_kind")
  loyaltySpentByn Decimal           @default(0) @map("loyalty_spent_byn") @db.Decimal(10, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  closedAt        DateTime?         @map("closed_at")
  items           OfflineSaleItem[]
  edits           OfflineSaleEdit[]
  certificates    OfflineSaleCertificate[]
  /// Оплата сертификатом (одним на чек).
  redemptions     CertificateRedemption[]

  @@map("offline_sales")
}

// Подарочные сертификаты в оффлайн-продаже (номиналы, без кешбека)
model OfflineSaleCertificate {
  id           Int         @id @default(autoincrement())
  saleId       Int         @map("sale_id")
  // onDelete: Cascade — так FK создан в миграции 20260728123000_gift_certificates.
  // Объявлено явно, чтобы Prisma не считала это дрейфом и не пересоздавала связь.
  sale         OfflineSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  denomination Decimal     @db.Decimal(10, 2)
  qty          Int         @default(1)

  @@map("offline_sale_certificates")
}

enum OfflineSaleStatus {
  open
  closed
  cancelled
}

model OfflineSaleItem {
  id       Int         @id @default(autoincrement())
  saleId   Int         @map("sale_id")
  sale     OfflineSale @relation(fields: [saleId], references: [id])
  productId Int        @map("product_id")
  product   Product    @relation(fields: [productId], references: [id])
  volumeMl  Int        @map("volume_ml")
  qty       Int
  priceByn  Decimal    @map("price_byn") @db.Decimal(10, 2)
  atomizerId Int?      @map("atomizer_id")
  atomizer   Atomizer? @relation(fields: [atomizerId], references: [id])

  @@map("offline_sale_items")
}

// Атомайзеры (флаконы под розлив), привязаны к объёму
model Atomizer {
  id        Int               @id @default(autoincrement())
  name      String
  volumeMl  Int               @map("volume_ml")
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  saleItems OfflineSaleItem[]

  @@map("atomizers")
}

model OfflineSaleEdit {
  id                Int         @id @default(autoincrement())
  saleId            Int         @map("sale_id")
  sale              OfflineSale @relation(fields: [saleId], references: [id])
  userId            Int         @map("user_id")
  editedAt          DateTime    @default(now()) @map("edited_at")
  changeDescription String      @map("change_description")
  beforeJson        Json        @map("before_json")
  afterJson         Json        @map("after_json")

  @@map("offline_sale_edits")
}
