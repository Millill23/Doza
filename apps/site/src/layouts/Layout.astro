---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.tsx";
import { SEARCH_VERIFICATION } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const SITE_URL = "https://doza-parfum.by";
const {
  title = "DOZA — оригинальная парфюмерия на розлив",
  description = "DOZA — магазин оригинальной парфюмерии на розлив. Подберите свой аромат: верхние, средние и базовые ноты, любой объём от 2 мл.",
  canonical = SITE_URL + Astro.url.pathname,
  ogImage = SITE_URL + "/logo.png",
  jsonLd = [],
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0e0d0a" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {SEARCH_VERIFICATION.yandex && (
      <meta name="yandex-verification" content={SEARCH_VERIFICATION.yandex} />
    )}
    {SEARCH_VERIFICATION.google && (
      <meta name="google-site-verification" content={SEARCH_VERIFICATION.google} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DOZA" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Структурированные данные (SEO + AI-движки) -->
    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Preconnect для Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Шрифты грузим без блокировки рендера -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <title>{title}</title>

    <!-- Критический CSS: фон до загрузки, чтобы не было FOUC -->
    <style is:inline>
      html { background-color: #0e0d0a; color: #f5f1e8; }
    </style>
  </head>
  <body class="bg-ink-900 text-ivory antialiased">
    <!-- ── Лоадер (появляется мгновенно, гаснет после загрузки) ── -->
    <div id="doza-loader">
      <div class="dl-inner">
        <div class="dl-logo">DOZA</div>
        <div class="dl-ring"></div>
        <p class="dl-msg" id="dl-msg">Открываем витрину…</p>
      </div>
    </div>
    <style is:inline>
      #doza-loader{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#0e0d0a;transition:opacity .5s ease}
      #doza-loader.dl-hide{opacity:0;pointer-events:none}
      .dl-inner{display:flex;flex-direction:column;align-items:center;gap:24px}
      .dl-logo{font-family:Cormorant,Georgia,serif;font-weight:600;font-size:56px;line-height:1;letter-spacing:.15em;background:linear-gradient(135deg,#f2d98d,#c9a24b 45%,#a57c2b);-webkit-background-clip:text;background-clip:text;color:transparent;animation:dl-pulse 1.8s ease-in-out infinite}
      .dl-ring{width:38px;height:38px;border-radius:50%;border:2px solid rgba(201,162,75,.2);border-top-color:#c9a24b;animation:dl-spin .9s linear infinite}
      .dl-msg{font-family:Montserrat,system-ui,sans-serif;font-size:14px;font-weight:300;color:#b6ad98;min-height:20px;max-width:280px;text-align:center;transition:opacity .3s ease}
      @keyframes dl-spin{to{transform:rotate(360deg)}}
      @keyframes dl-pulse{0%,100%{opacity:1}50%{opacity:.72}}
      @media (prefers-reduced-motion:reduce){.dl-ring{animation:dl-spin 2s linear infinite}.dl-logo{animation:none}}
    </style>
    <script is:inline>
      (function () {
        var msgs = [
          "Расставляем парфюм по полочкам…",
          "Подбираем ароматы специально для вас…",
          "Открываем флаконы с золотом…",
          "Смешиваем верхние и базовые ноты…",
          "Полируем витрину до блеска…",
          "Согреваем атмосферу перед показом…",
          "Готовим предложения только для вас…",
          "Разливаем ровно по каплям…",
          "Просим муз вдохновить каталог…",
        ];
        var el = document.getElementById("dl-msg");
        var i = Math.floor(Math.random() * msgs.length);
        if (el) el.textContent = msgs[i];
        var iv = setInterval(function () {
          if (!el) return;
          i = (i + 1) % msgs.length;
          el.style.opacity = "0";
          setTimeout(function () { el.textContent = msgs[i]; el.style.opacity = "1"; }, 250);
        }, 1500);
        function hide() {
          var l = document.getElementById("doza-loader");
          if (!l) return;
          clearInterval(iv);
          l.classList.add("dl-hide");
          setTimeout(function () { if (l && l.parentNode) l.parentNode.removeChild(l); }, 550);
        }
        if (document.readyState === "complete") hide();
        else window.addEventListener("load", hide);
        setTimeout(hide, 6000); // фолбэк, чтобы лоадер не завис
      })();
    </script>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent client:load />
  </body>
</html>
