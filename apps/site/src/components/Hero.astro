---
// Люксовая hero-секция DOZA. Полностью статична (0 JS).
// Дизайн на основе 21st.dev, адаптирован под дизайн-систему DOZA.
import TropicalFrond from "./TropicalFrond.astro";
---

<section class="relative w-full overflow-hidden bg-ink-900">
  <!-- Зернистость (film grain) -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style={`background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")`}
    aria-hidden="true"
  >
  </div>

  <!-- Мягкое золотое свечение -->
  <div
    class="absolute left-1/2 top-1/3 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-gold-500 opacity-[0.08] blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <!-- Тропические пальмовые акценты (вайя) -->
  <TropicalFrond
    class="pointer-events-none absolute -right-16 -top-12 h-[440px] w-auto rotate-[152deg] opacity-[0.16]"
    color="#4F6F44"
  />
  <TropicalFrond
    class="pointer-events-none absolute -bottom-20 -left-16 h-[400px] w-auto rotate-[8deg] opacity-[0.14]"
    color="#4F6F44"
  />
  <TropicalFrond
    class="pointer-events-none absolute -bottom-10 left-28 hidden h-[240px] w-auto -rotate-[14deg] opacity-[0.07] sm:block"
    color="#8FA67A"
  />

  <!-- Контент -->
  <div class="container-luxe relative z-10 flex min-h-[88vh] flex-col items-center justify-center py-20 text-center">
    <!-- Надстрочный акцент -->
    <div class="mb-6 flex items-center justify-center gap-3">
      <span class="h-px w-8 bg-gold-600/60"></span>
      <p class="text-xs font-light uppercase tracking-[0.25em] text-gold-500 sm:text-sm">
        Оригинальная парфюмерия на распив
      </p>
      <span class="h-px w-8 bg-gold-600/60"></span>
    </div>

    <!-- Заголовок -->
    <h1 class="mb-6 font-serif text-5xl font-semibold leading-[1.05] text-gold-gradient sm:text-6xl md:text-7xl lg:text-[5.5rem]">
      Откройте мир<br />изысканных ароматов
    </h1>

    <!-- Подзаголовок -->
    <p class="mx-auto mb-10 max-w-2xl text-base font-light leading-relaxed text-ivory-muted sm:text-lg">
      Оригинальные ароматы на распив — объёмы 3, 5 и 10 мл каждого аромата.
      Оплата картой онлайн.
    </p>

    <!-- CTA -->
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/catalog"
        class="group relative inline-flex h-12 items-center justify-center overflow-hidden rounded-full bg-gold-gradient px-8 text-base font-medium text-ink-900 shadow-gold transition-all duration-300 hover:shadow-gold-lg"
      >
        <span class="relative z-10">Открыть каталог</span>
      </a>
      <a
        href="/finder"
        class="inline-flex h-12 items-center justify-center rounded-full border border-gold-500/70 bg-transparent px-8 text-base font-light text-gold-400 transition-all duration-300 hover:border-gold-400 hover:bg-gold-500/10 hover:text-gold-300"
      >
        Подобрать аромат
      </a>
    </div>

    <!-- Преимущества -->
    <div class="mt-16 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm font-light text-ivory-faint">
      <div class="flex items-center gap-2">
        <span class="h-1 w-1 rounded-full bg-botanical-500"></span>
        <span>Только оригинал</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-1 w-1 rounded-full bg-botanical-500"></span>
        <span>Доставка почтой и самовывоз</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="h-1 w-1 rounded-full bg-botanical-500"></span>
        <span>Баллы за каждую покупку</span>
      </div>
    </div>
  </div>

  <!-- Нижний градиент -->
  <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-ink-900 to-transparent"></div>
</section>
