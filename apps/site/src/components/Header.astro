---
import { prisma } from "@doza/db";
import { getCustomerId } from "../lib/customer-auth";

/**
 * Шапка сайта.
 *
 * На узком экране ссылки скрыты — с телефона в каталог и к сертификатам ведут
 * кнопки на самих страницах, а не тесная строка меню.
 */

const links = [
  { href: "/catalog", label: "Каталог" },
  { href: "/finder", label: "Подобрать аромат" },
  { href: "/catalog?gender=male", label: "Мужские" },
  { href: "/catalog?gender=female", label: "Женские" },
  { href: "/catalog?gender=unisex", label: "Унисекс" },
  { href: "/about", label: "О нас" },
];

/**
 * Сертификаты стоят отдельно от остальных ссылок: это не раздел каталога, а
 * отдельный товар, и теряться среди «Мужские / Женские / Унисекс» ему нельзя.
 * На широком экране — короткой подписью, чтобы строка не переполнялась.
 */
const GIFT = {
  href: "/gift-card",
  short: "Сертификаты",
  full: "Подарочные сертификаты",
};

// Определяем вошедшего покупателя (для показа имени в шапке)
const customerId = getCustomerId(Astro.cookies);
let customerName: string | null = null;
if (customerId) {
  const c = await prisma.customer.findUnique({
    where: { id: customerId },
    select: { name: true },
  });
  customerName = c?.name ?? null;
}
---

<header
  class="sticky top-0 z-30 border-b border-ink-600/60 bg-ink-900/80 backdrop-blur-md"
>
  <nav class="container-luxe flex h-16 items-center justify-between gap-4">
    <!-- Логотип -->
    <a href="/" class="flex items-center gap-2" aria-label="DOZA — на главную">
      <span
        class="font-serif text-2xl font-semibold tracking-luxe text-gold-gradient"
        >DOZA</span
      >
    </a>

    <!-- Навигация (десктоп) -->
    <ul class="hidden items-center gap-5 md:flex lg:gap-7">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="whitespace-nowrap text-sm font-light text-ivory-muted transition-colors duration-200 hover:text-gold-400"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={GIFT.href}
          class="whitespace-nowrap text-sm font-light text-gold-400 transition-colors duration-200 hover:text-gold-300"
        >
          <span class="lg:hidden">{GIFT.short}</span>
          <span class="hidden lg:inline">{GIFT.full}</span>
        </a>
      </li>
    </ul>

    <!-- Действия -->
    <div class="flex items-center gap-3 sm:gap-4">
      {
        customerName ? (
          <a
            href="/account"
            aria-label="Личный кабинет"
            class="inline-flex items-center gap-2 text-sm font-light text-ivory-muted transition-colors duration-200 hover:text-gold-400"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span class="hidden max-w-[120px] truncate sm:inline">{customerName}</span>
          </a>
        ) : (
          <a
            href="/login"
            aria-label="Войти"
            class="inline-flex items-center gap-2 text-sm font-light text-ivory-muted transition-colors duration-200 hover:text-gold-400"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span class="hidden sm:inline">Войти</span>
          </a>
        )
      }
      <a
        href="/cart"
        class="inline-flex h-10 items-center gap-2 rounded-full border border-gold-600/40 px-3 text-sm text-gold-400 transition-colors duration-200 hover:border-gold-500 hover:text-gold-300 sm:px-4"
        aria-label="Корзина"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="8" cy="21" r="1"></circle>
          <circle cx="19" cy="21" r="1"></circle>
          <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"
          ></path>
        </svg>
        <span class="hidden sm:inline">Корзина</span>
        <span
          id="cart-badge"
          class="ml-0.5 hidden min-w-[20px] rounded-full bg-gold-gradient px-1.5 text-center text-xs font-semibold text-ink-900"
        ></span>
      </a>

    </div>
  </nav>

</header>

<script is:inline>
  (function () {
    // ── Счётчик корзины ────────────────────────────────────────────────────
    function count(key, each) {
      try {
        var list = JSON.parse(localStorage.getItem(key) || "[]");
        return Array.isArray(list) ? list.reduce(each, 0) : 0;
      } catch (e) {
        return 0;
      }
    }

    function update() {
      var badge = document.getElementById("cart-badge");
      if (!badge) return;
      // Сертификаты лежат отдельным ключом, но для покупателя корзина одна —
      // счётчик обязан считать и их, иначе добавленный подарок «пропадает».
      var total =
        count("doza_cart", function (s, i) {
          return s + (i.qty || 1);
        }) +
        count("doza_gift", function (s) {
          return s + 1;
        });

      if (total > 0) {
        badge.textContent = String(total);
        badge.classList.remove("hidden");
      } else {
        badge.classList.add("hidden");
      }
    }

    update();
    window.addEventListener("doza:cart-updated", update);
    window.addEventListener("storage", update);
    document.addEventListener("astro:after-swap", update);

  })();
</script>
