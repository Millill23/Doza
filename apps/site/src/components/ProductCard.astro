---
import type { ProductCard } from "../lib/types";
import { GENDER_LABELS } from "../lib/types";
import { formatByn } from "@doza/shared";

interface Props {
  product: ProductCard;
}

const { product } = Astro.props;
// У распроданного скидку не показываем ни плашкой, ни зачёркнутой ценой:
// выгодное предложение на то, чего нет, только злит.
const disc = product.soldOut || product.discountPercent <= 0 ? 0 : product.discountPercent;
const finalFrom =
  disc > 0
    ? Math.round(product.priceFrom * (1 - disc / 100) * 100) / 100
    : product.priceFrom;
---

<a
  href={`/product/${product.slug}`}
  class="group relative block overflow-hidden rounded-xl border border-ink-600/60 bg-ink-700 transition-all duration-300 hover:border-gold-500/70 hover:shadow-gold"
>
  <!-- Фото -->
  <div class="relative aspect-[3/4] overflow-hidden bg-ink-900">
    <img
      src={product.image}
      alt={`${product.brand} ${product.name}`}
      loading="lazy"
      decoding="async"
      class:list={[
        "h-full w-full object-cover transition-transform duration-500 group-hover:scale-105",
        product.soldOut && "opacity-40 grayscale",
      ]}
    />
    <!-- затемнение снизу -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink-700/90 to-transparent"
    >
    </div>
    <!-- бейдж гендера -->
    <span
      class="absolute left-3 top-3 rounded-full border border-gold-500/30 bg-ink-900/70 px-2.5 py-1 text-[11px] font-light text-gold-400 backdrop-blur-sm"
    >
      {GENDER_LABELS[product.gender]}
    </span>
    <!-- плашка «закончился». Карточку не прячем: аромат вернётся, а по
         названию его ищут и приходят из поиска. -->
    {product.soldOut && (
      <span
        class="absolute inset-x-0 top-1/2 -translate-y-1/2 bg-ink-900/85 py-2 text-center text-xs font-semibold uppercase tracking-luxe text-ivory backdrop-blur-sm"
      >
        Закончился
      </span>
    )}
    <!-- плашка скидки -->
    {disc > 0 && (
      <span
        class="absolute left-3 top-11 rounded-full bg-botanical-500 px-2.5 py-1 text-[11px] font-semibold text-ink-900"
      >
        −{disc}%
      </span>
    )}
    <!-- плашка повышенного кешбэка -->
    {!product.soldOut && product.cashbackBoosted && (
      <span
        class="absolute right-3 top-3 rounded-full bg-gold-gradient px-2.5 py-1 text-[11px] font-semibold text-ink-900 shadow-gold"
      >
        Вернём {product.cashbackPercent}% баллами
      </span>
    )}
  </div>

  <!-- Контент -->
  <div class="space-y-2 p-5">
    <div
      class="text-[11px] font-medium uppercase tracking-luxe text-gold-500"
    >
      {product.brand}
    </div>
    <h3 class="font-serif text-xl font-medium leading-tight text-ivory">
      {product.name}
    </h3>
    <div class="flex items-center justify-between pt-1">
      <span class="text-base font-medium text-gold-400">
        {disc > 0 ? (
          <>
            <span class="mr-1.5 text-sm font-light text-ivory-faint line-through">
              {product.priceFrom.toFixed(2)}
            </span>
            от {formatByn(finalFrom)}
          </>
        ) : (
          <>от {formatByn(product.priceFrom)}</>
        )}
      </span>
      <span
        class="translate-y-1 text-sm font-light text-ivory-faint opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:text-gold-400 group-hover:opacity-100"
      >
        {product.soldOut ? "Скоро вернётся" : "Подробнее →"}
      </span>
    </div>
  </div>
</a>
