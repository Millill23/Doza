---
import { COMPANY } from "../lib/company";
import TropicalFrond from "./TropicalFrond.astro";
const year = new Date().getFullYear();
const tel = COMPANY.phones[0];
const telHref = "tel:" + tel.replace(/[^\d+]/g, "");
---

<footer class="relative mt-24 overflow-hidden border-t border-ink-600/60 bg-ink-800">
  <TropicalFrond
    class="pointer-events-none absolute -right-10 -top-16 h-[300px] w-auto rotate-[160deg] opacity-[0.06]"
    color="#8FA67A"
  />
  <div class="container-luxe grid gap-10 py-14 md:grid-cols-3 lg:grid-cols-5">
    <div class="md:col-span-3 lg:col-span-2">
      <span class="font-serif text-2xl font-semibold tracking-luxe text-gold-gradient"
        >DOZA</span
      >
      <p class="mt-3 max-w-sm text-sm font-light leading-relaxed text-ivory-muted">
        Оригинальная парфюмерия на распив. Подберите свой аромат и закажите
        удобный объём — 3, 5 или 10 мл.
      </p>
      <p class="mt-4 text-xs text-ivory-faint">
        Оплата картой онлайн на защищённой странице банка. Доставка по Беларуси.
      </p>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-medium uppercase tracking-wide text-ivory">
        Покупателям
      </h3>
      <ul class="space-y-2 text-sm font-light text-ivory-muted">
        <li><a href="/catalog" class="transition-colors hover:text-gold-400">Каталог</a></li>
        <li><a href="/delivery" class="transition-colors hover:text-gold-400">Доставка и оплата</a></li>
        <li><a href="/loyalty" class="transition-colors hover:text-gold-400">Программа лояльности</a></li>
        <li><a href="/account" class="transition-colors hover:text-gold-400">Личный кабинет</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-medium uppercase tracking-wide text-ivory">
        Информация
      </h3>
      <ul class="space-y-2 text-sm font-light text-ivory-muted">
        <li><a href="/legal" class="transition-colors hover:text-gold-400">Юридическая информация</a></li>
        <li><a href="/privacy" class="transition-colors hover:text-gold-400">Политика перс. данных</a></li>
        <li><a href="/payment" class="transition-colors hover:text-gold-400">Оплата и безопасность</a></li>
        <li><a href="/offer" class="transition-colors hover:text-gold-400">Публичная оферта</a></li>
        <li><a href="/returns" class="transition-colors hover:text-gold-400">Возврат и возмещение</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-medium uppercase tracking-wide text-ivory">
        Контакты
      </h3>
      <ul class="space-y-2 text-sm font-light text-ivory-muted">
        <li><a href={telHref} class="transition-colors hover:text-gold-400">{tel}</a></li>
        <li>{COMPANY.actualAddress}</li>
        <li>{COMPANY.workingHours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-600/40">
    <div
      class="container-luxe flex flex-col items-center justify-between gap-2 py-5 text-xs text-ivory-faint sm:flex-row"
    >
      <span>© {year} DOZA. Все права защищены.</span>
      <span>doza-parfum.by</span>
    </div>
  </div>
</footer>
