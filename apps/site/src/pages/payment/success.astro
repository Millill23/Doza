---
import Layout from "../../layouts/Layout.astro";
import { COMPANY } from "../../lib/company";
import { verifyAndApply } from "../../lib/payment-verify";
import { prisma } from "@doza/db";
import { orderEventId } from "@doza/shared/meta-events";

export const prerender = false;

// bePaid добавляет в адрес token, uid и status. Берём только token: параметр
// status покупатель может поправить в адресной строке, поэтому оплату
// подтверждаем собственным запросом к шлюзу.
const token = Astro.url.searchParams.get("token") ?? "";

let result = null;
let error: string | null = null;
try {
  result = await verifyAndApply(token);
} catch (e) {
  console.error("[payment/success] проверка не удалась:", e);
  error = "Не удалось проверить платёж";
}

const paid = result?.paymentStatus === "paid";

/**
 * Покупка для пикселя.
 *
 * Это второй экземпляр того же события: первый уходит с сервера сразу после
 * подтверждения оплаты. Оба несут один `event_id`, и Meta склеивает их в одно.
 * Браузерный ценен тем, что приносит cookie и параметры рекламного перехода –
 * с ними Meta лучше сопоставляет покупку с объявлением. Но полагаться только
 * на него нельзя: покупатель может сюда и не дойти.
 */
let purchase: { eventId: string; value: number; ids: string[] } | null = null;
if (paid && result) {
  const order = await prisma.order.findUnique({
    where: { id: result.orderId },
    select: {
      totalByn: true,
      deliveryFeeByn: true,
      loyaltySpentByn: true,
      items: { select: { productId: true } },
    },
  });
  if (order) {
    purchase = {
      eventId: orderEventId(result.orderId),
      // Та же сумма, что ушла с карты: товары плюс доставка, минус баллы.
      value:
        Math.round(
          (Number(order.totalByn) +
            Number(order.deliveryFeeByn) -
            Number(order.loyaltySpentByn)) * 100,
        ) / 100,
      ids: order.items.map((i) => String(i.productId)),
    };
  }
}
---

<Layout title={paid ? "Заказ оплачен – DOZA" : "Проверяем платёж – DOZA"}>
  {purchase && (
    <script is:inline define:vars={{ purchase }}>
      if (typeof window.fbq === "function") {
        window.fbq(
          "track",
          "Purchase",
          {
            currency: "BYN",
            value: purchase.value,
            content_type: "product",
            content_ids: purchase.ids,
          },
          { eventID: purchase.eventId },
        );
      }
    </script>
  )}
  <section class="container-luxe max-w-2xl py-16">
    {
      paid ? (
        <div class="rounded-2xl border border-botanical-500/30 bg-botanical-500/5 p-8 text-center">
          <p class="mb-2 text-4xl">✓</p>
          <h1 class="mb-3 font-serif text-3xl text-ivory">Заказ оплачен</h1>
          <p class="text-sm leading-relaxed text-ivory-muted">
            Спасибо! Заказ №{result?.orderId} оплачен, мы уже собираем его.
            Свяжемся с вами по указанному телефону.
          </p>
          <a
            href="/catalog"
            class="mt-6 inline-flex h-11 items-center justify-center rounded-full bg-gold-gradient px-8 text-sm font-medium text-ink-900"
          >
            Вернуться в каталог
          </a>
        </div>
      ) : (
        <div class="rounded-2xl border border-ink-600/60 bg-ink-700 p-8 text-center">
          <p class="mb-2 text-4xl">⏳</p>
          <h1 class="mb-3 font-serif text-2xl text-ivory">Проверяем платёж</h1>
          <p class="text-sm leading-relaxed text-ivory-muted">
            {error
              ? "Не получилось сразу подтвердить оплату."
              : "Банк ещё не подтвердил операцию."}{" "}
            Если деньги списаны, заказ подтвердится автоматически в течение
            нескольких минут – повторно платить не нужно.
          </p>
          <p class="mt-4 text-sm text-ivory-faint">
            Остались вопросы – напишите на{" "}
            <span class="text-gold-400">{COMPANY.email}</span> или позвоните{" "}
            <span class="text-gold-400">{COMPANY.phones[0]}</span>.
          </p>
        </div>
      )
    }
  </section>
</Layout>
