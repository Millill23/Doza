---
import Layout from "../layouts/Layout.astro";
import FinderApp from "../components/FinderApp.tsx";
import { getFinderProducts } from "../lib/products";

const products = await getFinderProducts();
---

<Layout title="Подобрать аромат — DOZA">
  <section class="container-luxe py-12">
    <header class="mb-10 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-[0.25em] text-gold-500">
        Помощник
      </p>
      <h1 class="font-serif text-4xl font-semibold text-gold-gradient sm:text-5xl">
        Подобрать аромат
      </h1>
      <p class="mx-auto mt-3 max-w-lg text-sm font-light text-ivory-muted">
        Ответьте на пару вопросов — и мы предложим ароматы под ваш вкус.
      </p>
    </header>

    <FinderApp client:load products={products} />
  </section>
</Layout>
