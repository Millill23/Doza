---
import Layout from "../layouts/Layout.astro";
import RegisterForm from "../components/RegisterForm.tsx";
import { currentCustomerId } from "../lib/customer-auth";

if (await currentCustomerId(Astro.cookies)) return Astro.redirect("/account");
---

<Layout title="Регистрация — DOZA" noindex={true}>
  <section class="container-luxe py-12">
    <header class="mb-8 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-[0.25em] text-gold-500">
        Программа лояльности
      </p>
      <h1 class="font-serif text-4xl font-semibold text-gold-gradient">Регистрация</h1>
      <p class="mx-auto mt-3 max-w-md text-sm font-light text-ivory-muted">
        Зарегистрируйтесь, чтобы копить баллы и видеть историю заказов.
      </p>
    </header>
    <RegisterForm client:load />
  </section>
</Layout>
