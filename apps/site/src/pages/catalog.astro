---
/**
 * Старый адрес каталога.
 *
 * Каталог переехал на главную: лишний клик между покупателем и товаром убрали.
 * Здесь остаётся переадресация – на `/catalog` ведут ссылки из поиска, из
 * переписок и из чужих постов, и ломать их нельзя. Строка запроса едет с
 * собой, иначе `/catalog?gender=male` терял бы фильтр.
 */
const { search } = new URL(Astro.request.url);
return Astro.redirect("/" + search, 301);
---
