---
import Layout from "../layouts/Layout.astro";
import CatalogApp from "../components/CatalogApp.tsx";
import { getProducts, getBrands } from "../lib/products";
import { catalogItemListLd } from "../lib/seo";
import type { Gender } from "../lib/types";

const url = new URL(Astro.request.url);
const genderParam = (url.searchParams.get("gender") ?? "") as Gender | "";
const queryParam = url.searchParams.get("q") ?? "";
const boostedParam = url.searchParams.get("boosted") === "1";
const brandsParam = (url.searchParams.get("brands") ?? "")
  .split(",")
  .map((b) => decodeURIComponent(b.trim()))
  .filter(Boolean);

const [products, brands] = await Promise.all([getProducts(), getBrands()]);
---

<Layout
  title="Каталог парфюмерии на распив — DOZA"
  description="Каталог оригинальной парфюмерии на распив: мужские, женские и унисекс ароматы известных брендов. Любой объём от 2 мл, цены в BYN, оплата при получении."
  jsonLd={[catalogItemListLd(products)]}
>
  <section class="container-luxe py-12">
    <header class="mb-10 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-[0.25em] text-gold-500">
        Коллекция ароматов
      </p>
      <h1 class="font-serif text-4xl font-semibold text-gold-gradient sm:text-5xl">
        Каталог
      </h1>
    </header>

    <CatalogApp
      client:load
      products={products}
      brands={brands}
      initialGender={genderParam}
      initialQuery={queryParam}
      initialBrands={brandsParam}
      initialBoosted={boostedParam}
    />
  </section>
</Layout>
