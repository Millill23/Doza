---
import Layout from "../../layouts/Layout.astro";
import VolumeSelector from "../../components/VolumeSelector.tsx";
import ProductCard from "../../components/ProductCard.astro";
import { getProduct } from "../../lib/products";
import { GENDER_LABELS } from "../../lib/types";
import { productMeta, productFaq } from "../../lib/seo";

const { slug } = Astro.params;
const product = slug ? await getProduct(slug) : null;

if (!product) {
  return Astro.redirect("/catalog");
}

const notes = [
  { label: "Верхние ноты", value: product.notesTop },
  { label: "Средние ноты", value: product.notesMid },
  { label: "Базовые ноты", value: product.notesBase },
].filter((n) => n.value);

const meta = productMeta(product);
const faq = productFaq(product);
---

<Layout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  ogImage={meta.ogImage}
  jsonLd={meta.jsonLd}
>
  <section class="container-luxe py-10">
    <!-- Назад + хлебные крошки -->
    <div class="mb-8 flex items-center gap-4">
      <button
        id="back-btn"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-full border border-ink-600 px-4 py-2 text-sm text-ivory-muted transition-colors hover:border-gold-600/60 hover:text-gold-400"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Назад
      </button>
      <nav class="text-sm font-light text-ivory-faint">
        <a href="/catalog" class="transition-colors hover:text-gold-400">Каталог</a>
        <span class="mx-2">/</span>
        <span class="text-ivory-muted">{product.brand}</span>
      </nav>
    </div>

    <script is:inline>
      (function () {
        var btn = document.getElementById("back-btn");
        if (!btn) return;
        btn.addEventListener("click", function () {
          // если есть история в пределах сайта — назад (вернёт отфильтрованный каталог),
          // иначе — на каталог
          var ref = document.referrer;
          if (window.history.length > 1 && ref && ref.indexOf(window.location.origin) === 0) {
            window.history.back();
          } else {
            window.location.href = "/catalog";
          }
        });
      })();
    </script>

    <div class="grid gap-10 lg:grid-cols-2">
      <!-- Фото -->
      <div class="relative overflow-hidden rounded-2xl border border-ink-600/60 bg-ink-900">
        <img
          src={product.image}
          alt={`${product.brand} ${product.name}`}
          class="aspect-[4/5] w-full object-cover"
          fetchpriority="high"
        />
      </div>

      <!-- Инфо -->
      <div>
        <p class="mb-2 text-sm font-medium uppercase tracking-luxe text-gold-500">
          {product.brand}
        </p>
        <h1 class="mb-3 font-serif text-4xl font-semibold text-ivory sm:text-5xl">
          {product.name}
        </h1>
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span
            class="inline-block rounded-full border border-gold-500/30 px-3 py-1 text-xs font-light text-gold-400"
          >
            {GENDER_LABELS[product.gender]}
          </span>
          {product.cashbackBoosted ? (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-gold-gradient px-3 py-1 text-xs font-semibold text-ink-900 shadow-gold">
              Вернём {product.cashbackPercent}% баллами!
            </span>
          ) : (
            <span class="inline-block rounded-full border border-botanical-500/40 bg-botanical-700/20 px-3 py-1 text-xs font-light text-botanical-300">
              Кешбэк {product.cashbackPercent}% баллами
            </span>
          )}
        </div>

        {product.description && (
          <p class="mb-8 text-base font-light leading-relaxed text-ivory-muted">
            {product.description}
          </p>
        )}

        <VolumeSelector
          client:load
          productId={product.id}
          productName={product.name}
          brand={product.brand}
          image={product.image}
          volumes={product.volumes}
        />
      </div>
    </div>

    <!-- Ноты аромата -->
    {notes.length > 0 && (
      <div class="mt-16">
        <h2 class="mb-6 font-serif text-2xl font-medium text-ivory">Пирамида аромата</h2>
        <div class="grid gap-4 sm:grid-cols-3">
          {notes.map((n) => (
            <div class="rounded-xl border border-ink-600/60 bg-ink-700 p-5">
              <div class="mb-2 text-xs font-medium uppercase tracking-luxe text-gold-500">
                {n.label}
              </div>
              <p class="text-sm font-light text-ivory-muted">{n.value}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Похожие ароматы -->
    {product.similar.length > 0 && (
      <div class="mt-16">
        <h2 class="mb-6 font-serif text-2xl font-medium text-ivory">Похожие ароматы</h2>
        <div class="grid grid-cols-2 gap-5 sm:gap-6 md:grid-cols-4">
          {product.similar.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    )}

    <!-- Вопросы и ответы (SEO + AI-движки) -->
    <div class="mt-16 max-w-3xl">
      <h2 class="mb-6 font-serif text-2xl font-medium text-ivory">Вопросы и ответы</h2>
      <div class="space-y-3">
        {faq.map((f) => (
          <details class="group rounded-xl border border-ink-600/60 bg-ink-700 p-5">
            <summary class="cursor-pointer list-none font-medium text-ivory marker:content-none">
              {f.q}
            </summary>
            <p class="mt-3 text-sm font-light leading-relaxed text-ivory-muted">
              {f.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
