---
import Layout from "../layouts/Layout.astro";
import GiftCardApp from "../components/GiftCardApp.tsx";
import {
  CERTIFICATE_DENOMINATIONS,
  CERTIFICATE_LIFETIME_DAYS,
} from "@doza/db/certificate-rules";
---

<Layout
  title="Подарочный сертификат — DOZA"
  description="Подарочный сертификат на парфюмерию: номиналы от 50 до 500 BYN, бумажная карточка почтой или электронная версия ссылкой в SMS."
>
  <section class="container-luxe max-w-2xl py-12">
    <header class="mb-8 text-center">
      <p class="mb-3 text-xs font-light uppercase tracking-[0.25em] text-gold-500">
        Подарок
      </p>
      <h1 class="font-serif text-4xl font-semibold text-gold-gradient sm:text-5xl">
        Подарочный сертификат
      </h1>
      <p class="mx-auto mt-4 max-w-md text-sm font-light leading-relaxed text-ivory-muted">
        Сертификатом можно расплатиться в магазине или обменять его на баллы и
        оплатить заказ на сайте.
      </p>
    </header>

    <GiftCardApp
      client:load
      denominations={[...CERTIFICATE_DENOMINATIONS]}
      lifetimeDays={CERTIFICATE_LIFETIME_DAYS}
    />
  </section>
</Layout>
