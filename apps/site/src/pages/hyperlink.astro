---
// Лендинг под QR-код (офлайн-точка, визитки): ссылки на соцсети и телефон.
// Открывается в основном с телефона — крупные тап-зоны, минимум текста.
import Layout from "../layouts/Layout.astro";
import TropicalFrond from "../components/TropicalFrond.astro";
import { COMPANY } from "../lib/company";

const phone = COMPANY.phones[0];
const phoneHref = "tel:" + phone.replace(/[^\d+]/g, "");

const LINKS = [
  {
    href: "https://instagram.com/doza.parfum",
    label: "Instagram",
    handle: "doza.parfum",
    icon: "instagram",
  },
  {
    href: "https://tiktok.com/@doza.parfum",
    label: "TikTok",
    handle: "@doza.parfum",
    icon: "tiktok",
  },
  { href: phoneHref, label: "Позвонить", handle: phone, icon: "phone" },
];
---

<Layout
  title="DOZA — наши контакты и соцсети"
  description="Instagram, TikTok и телефон магазина оригинальной парфюмерии на распив DOZA."
>
  <section class="relative overflow-hidden">
    <TropicalFrond
      class="pointer-events-none absolute -right-16 -top-10 h-[320px] w-auto rotate-[155deg] opacity-[0.10]"
      color="#4F6F44"
    />
    <TropicalFrond
      class="pointer-events-none absolute -bottom-16 -left-16 h-[300px] w-auto rotate-[10deg] opacity-[0.08]"
      color="#4F6F44"
    />

    <div class="container-luxe relative z-10 max-w-md py-14">
      <header class="mb-10 text-center">
        <p class="mb-3 text-xs font-light uppercase tracking-[0.25em] text-gold-500">
          Оригинальная парфюмерия на распив
        </p>
        <h1 class="font-serif text-4xl font-semibold text-gold-gradient">DOZA</h1>
        <p class="mt-3 text-sm text-ivory-muted">
          {COMPANY.actualAddress}
        </p>
        <p class="mt-1 text-xs text-ivory-faint">{COMPANY.workingHours}</p>
      </header>

      <div class="space-y-3">
        {
          LINKS.map((l) => (
            <a
              href={l.href}
              target={l.icon === "phone" ? undefined : "_blank"}
              rel={l.icon === "phone" ? undefined : "noopener noreferrer"}
              class="group flex items-center gap-4 rounded-2xl border border-ink-600/60 bg-ink-700 px-5 py-4 transition-colors hover:border-gold-500/70 hover:bg-ink-600/60"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold-600/40 text-gold-400 transition-colors group-hover:border-gold-500">
                {l.icon === "instagram" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {l.icon === "tiktok" && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .76-5.06V9.7a5.68 5.68 0 1 0 4.92 5.62V9.01a7.35 7.35 0 0 0 4.29 1.38V7.3a4.29 4.29 0 0 1-3.23-1.48Z" />
                  </svg>
                )}
                {l.icon === "phone" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
                  </svg>
                )}
              </span>
              <span class="min-w-0">
                <span class="block text-base font-medium text-ivory">{l.label}</span>
                <span class="block truncate text-sm text-ivory-muted">{l.handle}</span>
              </span>
              <span class="ml-auto text-gold-600/70 transition-colors group-hover:text-gold-400" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>

      <a
        href="/catalog"
        class="mt-8 flex h-12 items-center justify-center rounded-full bg-gold-gradient px-8 text-base font-medium text-ink-900 shadow-gold transition-all duration-300 hover:shadow-gold-lg"
      >
        Открыть каталог
      </a>

      <p class="mt-6 text-center text-xs leading-relaxed text-ivory-faint">
        Подписывайтесь — 5% скидки за подписку и ещё 5% за отметку в сторис.
      </p>
    </div>
  </section>
</Layout>
